[Unit]
Description=ProperDesktop locale generation

[Service]
Type=dbus
BusName=org.properdesktop.Locales
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/properdesktop-locales
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# locale.gen is replaced through a new file beside it.
ReadWritePaths=-/usr/lib/locale /etc

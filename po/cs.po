#: properdesktop-services/battery/battery.cpp
msgid "Calculating…"
msgstr "Počítání…"

#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "{time} until fully charged"
msgstr "{time} do úplného nabití"

#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "{time} remaining"
msgstr "Zbývá {time}"

#: properdesktop-services/battery/battery.cpp
msgid "Fully charged."
msgstr "Plně nabito."

#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "Charging paused at {percent}%"
msgstr "Nabíjení pozastaveno na {percent} %"

#: properdesktop-services/battery/battery.cpp
msgid "Not charging"
msgstr "Nenabíjí se"

#. TRANSLATORS: days in a short battery time such as "1d 2h 5m".
#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "{n}d"
msgstr "{n} d"

#. TRANSLATORS: hours in a short battery time such as "2h 5m".
#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "{n}h"
msgstr "{n} h"

#. TRANSLATORS: minutes in a short battery time such as "2h 5m".
#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "{n}m"
msgstr "{n} min"

#. TRANSLATORS: when the battery was last fully charged, under a minute ago.
#: properdesktop-services/battery/battery.cpp
msgid "now"
msgstr "právě teď"

#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "{time} ago"
msgstr "před {time}"

#: properdesktop-services/battery/batterywarning.cpp
msgid "Low Battery"
msgstr "Slabá baterie"

#: properdesktop-services/battery/batterywarning.cpp
msgid "Battery Critically Low"
msgstr "Kriticky slabá baterie"

#: properdesktop-services/battery/batterywarning.cpp
msgid "Battery Empty"
msgstr "Baterie je vybitá"

#: properdesktop-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining ({time})."
msgstr "Zbývá {percent} % baterie ({time})."

#: properdesktop-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining."
msgstr "Zbývá {percent} % baterie."

#: properdesktop-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will shut down when the battery is nearly empty."
msgstr "Uložte svou práci a připojte napájení. Až bude baterie téměř vybitá, počítač se vypne."

#: properdesktop-services/battery/batterywarning.cpp
msgid "Connect to power. The computer will hibernate when the battery is nearly empty."
msgstr "Připojte napájení. Až bude baterie téměř vybitá, počítač přejde do režimu hibernace."

#: properdesktop-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will go to sleep when the battery is nearly empty."
msgstr "Uložte svou práci a připojte napájení. Až bude baterie téměř vybitá, počítač přejde do režimu spánku."

#: properdesktop-services/battery/batterywarning.cpp
msgid "Connect to power soon."
msgstr "Brzy připojte napájení."

#: properdesktop-services/battery/batterywarning.cpp
msgid "The computer is about to shut down. Connect to power to keep it running."
msgstr "Počítač se brzy vypne. Aby zůstal zapnutý, připojte napájení."

#: properdesktop-services/battery/batterywarning.cpp
msgid "The computer is about to hibernate. Connect to power to keep it running."
msgstr "Počítač brzy přejde do režimu hibernace. Aby zůstal zapnutý, připojte napájení."

#: properdesktop-services/battery/batterywarning.cpp
msgid "The computer is about to go to sleep. Connect to power to keep it running."
msgstr "Počítač brzy přejde do režimu spánku. Aby zůstal zapnutý, připojte napájení."

#: properdesktop-services/battery/batterywarning.cpp
msgid "Connect to power now."
msgstr "Ihned připojte napájení."

#: properdesktop-services/bundlerunner/installdialog.cpp
#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Cancel"
msgstr "Zrušit"

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Install"
msgstr "Instalovat"

#: properdesktop-services/bundlerunner/installdialog.cpp
#: properdesktop-services/crash/crashdialog.cpp
msgid "OK"
msgstr "OK"

#: properdesktop-services/bundlerunner/installdialog.cpp
#, python-brace-format
msgid "To open “{name}”, Reef has to be downloaded and installed."
msgstr "Chcete-li otevřít „{name}“, je nutné stáhnout a nainstalovat Reef."

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Installing…"
msgstr "Instalace…"

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Downloading…"
msgstr "Stahování…"

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Looking for Reef…"
msgstr "Hledání Reef…"

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Reef is not available for this computer."
msgstr "Reef není pro tento počítač k dispozici."

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Reef could not be installed."
msgstr "Reef se nepodařilo nainstalovat."

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Stop"
msgstr "Zastavit"

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Install Reef"
msgstr "Instalace Reef"

#: properdesktop-services/crash/crashdialog.cpp
#, python-brace-format
msgid "“{name}” quit unexpectedly"
msgstr "Aplikace „{name}“ byla neočekávaně ukončena"

#: properdesktop-services/crash/crashdialog.cpp
msgid "Close"
msgstr "Zavřít"

#: properdesktop-services/crash/crashdialog.cpp
msgid "Reopen"
msgstr "Znovu otevřít"

#: properdesktop-services/crash/crashdialog.cpp
#, python-brace-format
msgid "Reason: {reason}"
msgstr "Důvod: {reason}"

#: properdesktop-services/crash/crashdialog.cpp
msgid "It is restarted automatically."
msgstr "Bude automaticky restartována."

#: properdesktop-services/crash/crashmanager.cpp
msgid "Application Runtime"
msgstr "Běhové prostředí aplikací"

#: properdesktop-services/locale/language.cpp
msgid "Some applications may need to be restarted for the change to take effect."
msgstr "Některé aplikace bude možná nutné restartovat, aby se změna projevila."

#: properdesktop-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Share your screen with “{name}”"
msgstr "Sdílet obrazovku s aplikací „{name}“"

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Choose a display or a window. What is shown on it will be visible to the application until it stops sharing."
msgstr "Vyberte obrazovku nebo okno. Co se na něm zobrazuje, bude aplikace vidět, dokud sdílení neukončí."

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Choose a window. Its contents will be visible to the application until it stops sharing."
msgstr "Vyberte okno. Jeho obsah bude aplikace vidět, dokud sdílení neukončí."

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Choose a display. Everything shown on it, including other windows, will be visible to the application until it stops sharing."
msgstr "Vyberte obrazovku. Vše, co se na ní zobrazuje, včetně ostatních oken, bude aplikace vidět, dokud sdílení neukončí."

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Share"
msgstr "Sdílet"

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Windows"
msgstr "Okna"

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Displays"
msgstr "Obrazovky"

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Always allow this app"
msgstr "Vždy povolit této aplikaci"

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Let “An app” control this computer?"
msgstr "Povolit „aplikaci“ ovládat tento počítač?"

#: properdesktop-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Let “{name}” control this computer?"
msgstr "Povolit aplikaci „{name}“ ovládat tento počítač?"

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "It will see your screen and use the pointer and keyboard until you stop it with the Stop button in the menu bar. Using the pointer or keyboard yourself pauses it, and it cannot answer system dialogs like this one."
msgstr "Uvidí vaši obrazovku a bude používat ukazatel a klávesnici, dokud ji nezastavíte tlačítkem Zastavit v řádku nabídek. Když sami použijete ukazatel nebo klávesnici, pozastaví se. Na systémové dialogy, jako je tento, odpovídat nemůže."

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Allow"
msgstr "Povolit"

#: properdesktop-services/softwareupdate/softwareupdate.cpp
msgid "Updates Installed"
msgstr "Aktualizace nainstalovány"

#: properdesktop-services/softwareupdate/softwareupdate.cpp
msgid "Restart the computer to finish installing them."
msgstr "Restartujte počítač, aby se instalace dokončila."

#: properdesktop-services/softwareupdate/softwareupdate.cpp
msgid "Software Updates Available"
msgstr "K dispozici jsou aktualizace softwaru"

#: properdesktop-services/softwareupdate/softwareupdate.cpp
#, python-brace-format
msgid "{n} update is available for this computer."
msgid_plural "{n} updates are available for this computer."
msgstr[0] "Pro tento počítač je k dispozici {n} aktualizace."
msgstr[1] "Pro tento počítač jsou k dispozici {n} aktualizace."
msgstr[2] "Pro tento počítač je k dispozici {n} aktualizací."

#: session/processmanager.cpp
msgid "Log out cancelled"
msgstr "Odhlášení zrušeno"

#: session/processmanager.cpp
msgid "Restart cancelled"
msgstr "Restart zrušen"

#: session/processmanager.cpp
msgid "Shutdown cancelled"
msgstr "Vypnutí zrušeno"

#: session/processmanager.cpp
msgid "An application cancelled it."
msgstr "Zrušila ho jedna z aplikací."

#: session/processmanager.cpp
msgid "An application did not quit."
msgstr "Jedna z aplikací se neukončila."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} cancelled it."
msgstr "Zrušila ho aplikace {name}."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} did not quit."
msgstr "Aplikace {name} se neukončila."

#. TRANSLATORS: the sender of a notification from the session itself.
#: session/processmanager.cpp
msgid "System"
msgstr "Systém"

#: session/properdesktop-wayland.desktop
msgid "Proper Desktop (Wayland)"
msgstr "Proper Desktop (Wayland)"

#: session/properdesktop-wayland.desktop
msgid "Proper Desktop session"
msgstr "Relace pracovního prostředí Proper Desktop"

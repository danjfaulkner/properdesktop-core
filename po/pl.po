#: properdesktop-services/battery/battery.cpp
msgid "Calculating…"
msgstr "Obliczanie…"

#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "{time} until fully charged"
msgstr "{time} do pełnego naładowania"

#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "{time} remaining"
msgstr "Pozostało {time}"

#: properdesktop-services/battery/battery.cpp
msgid "Fully charged."
msgstr "W pełni naładowana."

#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "Charging paused at {percent}%"
msgstr "Ładowanie wstrzymane przy {percent}%"

#: properdesktop-services/battery/battery.cpp
msgid "Not charging"
msgstr "Nie ładuje się"

#. TRANSLATORS: days in a short battery time such as "1d 2h 5m".
#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "{n}d"
msgstr "{n} d"

#. TRANSLATORS: hours in a short battery time such as "2h 5m".
#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "{n}h"
msgstr "{n} godz."

#. TRANSLATORS: minutes in a short battery time such as "2h 5m".
#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "{n}m"
msgstr "{n} min"

#. TRANSLATORS: when the battery was last fully charged, under a minute ago.
#: properdesktop-services/battery/battery.cpp
msgid "now"
msgstr "teraz"

#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "{time} ago"
msgstr "{time} temu"

#: properdesktop-services/battery/batterywarning.cpp
msgid "Low Battery"
msgstr "Niski poziom baterii"

#: properdesktop-services/battery/batterywarning.cpp
msgid "Battery Critically Low"
msgstr "Krytycznie niski poziom baterii"

#: properdesktop-services/battery/batterywarning.cpp
msgid "Battery Empty"
msgstr "Bateria rozładowana"

#: properdesktop-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining ({time})."
msgstr "Pozostało {percent}% baterii ({time})."

#: properdesktop-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining."
msgstr "Pozostało {percent}% baterii."

#: properdesktop-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will shut down when the battery is nearly empty."
msgstr "Zapisz swoją pracę i podłącz zasilanie. Komputer wyłączy się, gdy bateria będzie prawie rozładowana."

#: properdesktop-services/battery/batterywarning.cpp
msgid "Connect to power. The computer will hibernate when the battery is nearly empty."
msgstr "Podłącz zasilanie. Komputer przejdzie w stan hibernacji, gdy bateria będzie prawie rozładowana."

#: properdesktop-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will go to sleep when the battery is nearly empty."
msgstr "Zapisz swoją pracę i podłącz zasilanie. Komputer przejdzie w stan uśpienia, gdy bateria będzie prawie rozładowana."

#: properdesktop-services/battery/batterywarning.cpp
msgid "Connect to power soon."
msgstr "Wkrótce podłącz zasilanie."

#: properdesktop-services/battery/batterywarning.cpp
msgid "The computer is about to shut down. Connect to power to keep it running."
msgstr "Komputer zaraz się wyłączy. Podłącz zasilanie, aby nadal działał."

#: properdesktop-services/battery/batterywarning.cpp
msgid "The computer is about to hibernate. Connect to power to keep it running."
msgstr "Komputer zaraz przejdzie w stan hibernacji. Podłącz zasilanie, aby nadal działał."

#: properdesktop-services/battery/batterywarning.cpp
msgid "The computer is about to go to sleep. Connect to power to keep it running."
msgstr "Komputer zaraz przejdzie w stan uśpienia. Podłącz zasilanie, aby nadal działał."

#: properdesktop-services/battery/batterywarning.cpp
msgid "Connect to power now."
msgstr "Natychmiast podłącz zasilanie."

#: properdesktop-services/bundlerunner/installdialog.cpp
#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Cancel"
msgstr "Anuluj"

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Install"
msgstr "Zainstaluj"

#: properdesktop-services/bundlerunner/installdialog.cpp
#: properdesktop-services/crash/crashdialog.cpp
msgid "OK"
msgstr "OK"

#: properdesktop-services/bundlerunner/installdialog.cpp
#, python-brace-format
msgid "To open “{name}”, Reef has to be downloaded and installed."
msgstr "Aby otworzyć „{name}”, trzeba pobrać i zainstalować Reef."

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Installing…"
msgstr "Instalowanie…"

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Downloading…"
msgstr "Pobieranie…"

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Looking for Reef…"
msgstr "Wyszukiwanie Reef…"

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Reef is not available for this computer."
msgstr "Reef jest niedostępny dla tego komputera."

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Reef could not be installed."
msgstr "Nie udało się zainstalować Reef."

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Stop"
msgstr "Zatrzymaj"

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Install Reef"
msgstr "Instalacja Reef"

#: properdesktop-services/crash/crashdialog.cpp
#, python-brace-format
msgid "“{name}” quit unexpectedly"
msgstr "Aplikacja „{name}” nieoczekiwanie zakończyła działanie"

#: properdesktop-services/crash/crashdialog.cpp
msgid "Close"
msgstr "Zamknij"

#: properdesktop-services/crash/crashdialog.cpp
msgid "Reopen"
msgstr "Otwórz ponownie"

#: properdesktop-services/crash/crashdialog.cpp
#, python-brace-format
msgid "Reason: {reason}"
msgstr "Przyczyna: {reason}"

#: properdesktop-services/crash/crashdialog.cpp
msgid "It is restarted automatically."
msgstr "Zostanie automatycznie uruchomiona ponownie."

#: properdesktop-services/crash/crashmanager.cpp
msgid "Application Runtime"
msgstr "Środowisko uruchomieniowe aplikacji"

#: properdesktop-services/locale/language.cpp
msgid "Some applications may need to be restarted for the change to take effect."
msgstr "Niektóre aplikacje mogą wymagać ponownego uruchomienia, aby zmiana zaczęła obowiązywać."

#: properdesktop-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Share your screen with “{name}”"
msgstr "Udostępnij ekran aplikacji „{name}”"

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Choose a display or a window. What is shown on it will be visible to the application until it stops sharing."
msgstr "Wybierz ekran lub okno. To, co jest na nim widoczne, będzie widoczne dla aplikacji, dopóki nie przestanie udostępniać."

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Choose a window. Its contents will be visible to the application until it stops sharing."
msgstr "Wybierz okno. Jego zawartość będzie widoczna dla aplikacji, dopóki nie przestanie udostępniać."

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Choose a display. Everything shown on it, including other windows, will be visible to the application until it stops sharing."
msgstr "Wybierz ekran. Wszystko, co jest na nim widoczne, łącznie z innymi oknami, będzie widoczne dla aplikacji, dopóki nie przestanie udostępniać."

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Share"
msgstr "Udostępnij"

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Windows"
msgstr "Okna"

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Displays"
msgstr "Ekrany"

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Always allow this app"
msgstr "Zawsze zezwalaj tej aplikacji"

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Let “An app” control this computer?"
msgstr "Zezwolić aplikacji na sterowanie tym komputerem?"

#: properdesktop-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Let “{name}” control this computer?"
msgstr "Zezwolić aplikacji „{name}” na sterowanie tym komputerem?"

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "It will see your screen and use the pointer and keyboard until you stop it with the Stop button in the menu bar. Using the pointer or keyboard yourself pauses it, and it cannot answer system dialogs like this one."
msgstr "Aplikacja będzie widzieć Twój ekran i używać wskaźnika oraz klawiatury, dopóki jej nie zatrzymasz przyciskiem Zatrzymaj na pasku menu. Gdy sam użyjesz wskaźnika lub klawiatury, aplikacja wstrzyma działanie. Nie może odpowiadać na okna systemowe takie jak to."

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Allow"
msgstr "Zezwól"

#: properdesktop-services/softwareupdate/softwareupdate.cpp
msgid "Updates Installed"
msgstr "Zainstalowano aktualizacje"

#: properdesktop-services/softwareupdate/softwareupdate.cpp
msgid "Restart the computer to finish installing them."
msgstr "Uruchom ponownie komputer, aby dokończyć ich instalację."

#: properdesktop-services/softwareupdate/softwareupdate.cpp
msgid "Software Updates Available"
msgstr "Dostępne są aktualizacje oprogramowania"

#: properdesktop-services/softwareupdate/softwareupdate.cpp
#, python-brace-format
msgid "{n} update is available for this computer."
msgid_plural "{n} updates are available for this computer."
msgstr[0] "Dla tego komputera dostępna jest {n} aktualizacja."
msgstr[1] "Dla tego komputera dostępne są {n} aktualizacje."
msgstr[2] "Dla tego komputera dostępnych jest {n} aktualizacji."

#: session/processmanager.cpp
msgid "Log out cancelled"
msgstr "Anulowano wylogowanie"

#: session/processmanager.cpp
msgid "Restart cancelled"
msgstr "Anulowano ponowne uruchomienie"

#: session/processmanager.cpp
msgid "Shutdown cancelled"
msgstr "Anulowano wyłączenie"

#: session/processmanager.cpp
msgid "An application cancelled it."
msgstr "Aplikacja anulowała tę operację."

#: session/processmanager.cpp
msgid "An application did not quit."
msgstr "Aplikacja nie zakończyła działania."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} cancelled it."
msgstr "Aplikacja {name} anulowała tę operację."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} did not quit."
msgstr "Aplikacja {name} nie zakończyła działania."

#. TRANSLATORS: the sender of a notification from the session itself.
#: session/processmanager.cpp
msgid "System"
msgstr "System"

#: session/properdesktop-wayland.desktop
msgid "Proper Desktop (Wayland)"
msgstr "Proper Desktop (Wayland)"

#: session/properdesktop-wayland.desktop
msgid "Proper Desktop session"
msgstr "Sesja pulpitu Proper Desktop"

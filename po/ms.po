#: properdesktop-services/battery/battery.cpp
msgid "Calculating…"
msgstr "Mengira…"

#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "{time} until fully charged"
msgstr "{time} sehingga dicas penuh"

#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "{time} remaining"
msgstr "{time} lagi"

#: properdesktop-services/battery/battery.cpp
msgid "Fully charged."
msgstr "Dicas penuh."

#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "Charging paused at {percent}%"
msgstr "Pengecasan dijeda pada {percent}%"

#: properdesktop-services/battery/battery.cpp
msgid "Not charging"
msgstr "Tidak mengecas"

#. TRANSLATORS: days in a short battery time such as "1d 2h 5m".
#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "{n}d"
msgstr "{n}hr"

#. TRANSLATORS: hours in a short battery time such as "2h 5m".
#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "{n}h"
msgstr "{n}j"

#. TRANSLATORS: minutes in a short battery time such as "2h 5m".
#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "{n}m"
msgstr "{n}m"

#. TRANSLATORS: when the battery was last fully charged, under a minute ago.
#: properdesktop-services/battery/battery.cpp
msgid "now"
msgstr "baru sahaja"

#: properdesktop-services/battery/battery.cpp
#, python-brace-format
msgid "{time} ago"
msgstr "{time} yang lalu"

#: properdesktop-services/battery/batterywarning.cpp
msgid "Low Battery"
msgstr "Bateri Lemah"

#: properdesktop-services/battery/batterywarning.cpp
msgid "Battery Critically Low"
msgstr "Bateri Sangat Lemah"

#: properdesktop-services/battery/batterywarning.cpp
msgid "Battery Empty"
msgstr "Bateri Kosong"

#: properdesktop-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining ({time})."
msgstr "{percent}% bateri berbaki ({time})."

#: properdesktop-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining."
msgstr "{percent}% bateri berbaki."

#: properdesktop-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will shut down when the battery is nearly empty."
msgstr "Simpan kerja anda dan sambungkan kepada kuasa. Komputer akan dimatikan apabila bateri hampir kosong."

#: properdesktop-services/battery/batterywarning.cpp
msgid "Connect to power. The computer will hibernate when the battery is nearly empty."
msgstr "Sambungkan kepada kuasa. Komputer akan berhibernasi apabila bateri hampir kosong."

#: properdesktop-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will go to sleep when the battery is nearly empty."
msgstr "Simpan kerja anda dan sambungkan kepada kuasa. Komputer akan tidur apabila bateri hampir kosong."

#: properdesktop-services/battery/batterywarning.cpp
msgid "Connect to power soon."
msgstr "Sambungkan kepada kuasa segera."

#: properdesktop-services/battery/batterywarning.cpp
msgid "The computer is about to shut down. Connect to power to keep it running."
msgstr "Komputer akan dimatikan sebentar lagi. Sambungkan kepada kuasa untuk terus menggunakannya."

#: properdesktop-services/battery/batterywarning.cpp
msgid "The computer is about to hibernate. Connect to power to keep it running."
msgstr "Komputer akan berhibernasi sebentar lagi. Sambungkan kepada kuasa untuk terus menggunakannya."

#: properdesktop-services/battery/batterywarning.cpp
msgid "The computer is about to go to sleep. Connect to power to keep it running."
msgstr "Komputer akan tidur sebentar lagi. Sambungkan kepada kuasa untuk terus menggunakannya."

#: properdesktop-services/battery/batterywarning.cpp
msgid "Connect to power now."
msgstr "Sambungkan kepada kuasa sekarang."

#: properdesktop-services/bundlerunner/installdialog.cpp
#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Cancel"
msgstr "Batal"

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Install"
msgstr "Pasang"

#: properdesktop-services/bundlerunner/installdialog.cpp
#: properdesktop-services/crash/crashdialog.cpp
msgid "OK"
msgstr "OK"

#: properdesktop-services/bundlerunner/installdialog.cpp
#, python-brace-format
msgid "To open “{name}”, Reef has to be downloaded and installed."
msgstr "Untuk membuka “{name}”, Reef perlu dimuat turun dan dipasang."

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Installing…"
msgstr "Memasang…"

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Downloading…"
msgstr "Memuat turun…"

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Looking for Reef…"
msgstr "Mencari Reef…"

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Reef is not available for this computer."
msgstr "Reef tidak tersedia untuk komputer ini."

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Reef could not be installed."
msgstr "Reef tidak dapat dipasang."

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Stop"
msgstr "Henti"

#: properdesktop-services/bundlerunner/installdialog.cpp
msgid "Install Reef"
msgstr "Pasang Reef"

#: properdesktop-services/crash/crashdialog.cpp
#, python-brace-format
msgid "“{name}” quit unexpectedly"
msgstr "“{name}” keluar secara tidak dijangka"

#: properdesktop-services/crash/crashdialog.cpp
msgid "Close"
msgstr "Tutup"

#: properdesktop-services/crash/crashdialog.cpp
msgid "Reopen"
msgstr "Buka Semula"

#: properdesktop-services/crash/crashdialog.cpp
#, python-brace-format
msgid "Reason: {reason}"
msgstr "Sebab: {reason}"

#: properdesktop-services/crash/crashdialog.cpp
msgid "It is restarted automatically."
msgstr "Ia dimulakan semula secara automatik."

#: properdesktop-services/crash/crashmanager.cpp
msgid "Application Runtime"
msgstr "Masa Jalan Aplikasi"

#: properdesktop-services/locale/language.cpp
msgid "Some applications may need to be restarted for the change to take effect."
msgstr "Sesetengah aplikasi mungkin perlu dimulakan semula supaya perubahan berkuat kuasa."

#: properdesktop-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Share your screen with “{name}”"
msgstr "Kongsi skrin anda dengan “{name}”"

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Choose a display or a window. What is shown on it will be visible to the application until it stops sharing."
msgstr "Pilih paparan atau tetingkap. Apa yang ditunjukkan padanya akan kelihatan kepada aplikasi sehingga ia berhenti berkongsi."

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Choose a window. Its contents will be visible to the application until it stops sharing."
msgstr "Pilih tetingkap. Kandungannya akan kelihatan kepada aplikasi sehingga ia berhenti berkongsi."

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Choose a display. Everything shown on it, including other windows, will be visible to the application until it stops sharing."
msgstr "Pilih paparan. Semua yang ditunjukkan padanya, termasuk tetingkap lain, akan kelihatan kepada aplikasi sehingga ia berhenti berkongsi."

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Share"
msgstr "Kongsi"

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Windows"
msgstr "Tetingkap"

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Displays"
msgstr "Paparan"

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Always allow this app"
msgstr "Sentiasa benarkan aplikasi ini"

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Let “An app” control this computer?"
msgstr "Benarkan “Sebuah aplikasi” mengawal komputer ini?"

#: properdesktop-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Let “{name}” control this computer?"
msgstr "Benarkan “{name}” mengawal komputer ini?"

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "It will see your screen and use the pointer and keyboard until you stop it with the Stop button in the menu bar. Using the pointer or keyboard yourself pauses it, and it cannot answer system dialogs like this one."
msgstr "Ia akan melihat skrin anda dan menggunakan penuding serta papan kekunci sehingga anda menghentikannya dengan butang Henti dalam bar menu. Menggunakan penuding atau papan kekunci sendiri akan menjedanya, dan ia tidak boleh menjawab dialog sistem seperti ini."

#: properdesktop-services/permissions/permissionprompt.cpp
msgid "Allow"
msgstr "Benarkan"

#: properdesktop-services/softwareupdate/softwareupdate.cpp
msgid "Updates Installed"
msgstr "Kemas Kini Dipasang"

#: properdesktop-services/softwareupdate/softwareupdate.cpp
msgid "Restart the computer to finish installing them."
msgstr "Mulakan semula komputer untuk menyelesaikan pemasangannya."

#: properdesktop-services/softwareupdate/softwareupdate.cpp
msgid "Software Updates Available"
msgstr "Kemas Kini Perisian Tersedia"

#: properdesktop-services/softwareupdate/softwareupdate.cpp
#, python-brace-format
msgid "{n} update is available for this computer."
msgid_plural "{n} updates are available for this computer."
msgstr[0] "{n} kemas kini tersedia untuk komputer ini."

#: session/processmanager.cpp
msgid "Log out cancelled"
msgstr "Log keluar dibatalkan"

#: session/processmanager.cpp
msgid "Restart cancelled"
msgstr "Mula semula dibatalkan"

#: session/processmanager.cpp
msgid "Shutdown cancelled"
msgstr "Penutupan dibatalkan"

#: session/processmanager.cpp
msgid "An application cancelled it."
msgstr "Sebuah aplikasi telah membatalkannya."

#: session/processmanager.cpp
msgid "An application did not quit."
msgstr "Sebuah aplikasi tidak keluar."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} cancelled it."
msgstr "{name} telah membatalkannya."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} did not quit."
msgstr "{name} tidak keluar."

#. TRANSLATORS: the sender of a notification from the session itself.
#: session/processmanager.cpp
msgid "System"
msgstr "Sistem"

#: session/properdesktop-wayland.desktop
msgid "Proper Desktop (Wayland)"
msgstr "Proper Desktop (Wayland)"

#: session/properdesktop-wayland.desktop
msgid "Proper Desktop session"
msgstr "Sesi desktop Proper Desktop"

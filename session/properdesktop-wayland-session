#!/bin/sh
# Session management stays in core/session; it supervises properdesktop-compositor.
export XDG_CURRENT_DESKTOP=ProperDesktop
export XDG_SESSION_DESKTOP=ProperDesktop
export DESKTOP_SESSION=ProperDesktop
export XDG_SESSION_TYPE=wayland
export WAYLAND_DISPLAY=properdesktop-0
unset DISPLAY XAUTHORITY WAYLAND_SOCKET
exec /usr/bin/properdesktop-session "$@"
